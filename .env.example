# GGPrint Production / Proxmox Docker Compose Configuration
# Copy this file to .env and replace all placeholder secrets before starting.

# PostgreSQL
POSTGRES_DB=ggprint
POSTGRES_USER=ggprint
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# Security (minimum 16 characters; generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-64-char-random-hex-secret-generated-with-openssl

# Application Mode (keep false in production so mock modes are blocked & setup wizard runs on first boot)
DEV_SEED=false
INSTITUTION=Cégep Gérald-Godin

# Ports
FRONTEND_PORT=80
BACKEND_PORT=8000

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost","http://localhost:8080"]

# Slicer & Background Polling
ORCA_CLI_PATH_OVERRIDE=/usr/local/bin/orca-slicer-headless
POLL_INTERVAL_SECONDS=15

# Docker Images & Self-Updater (optional)
GGPRINT_BACKEND_IMAGE=ghcr.io/yashthebabydragon/ggprint-web-backend
GGPRINT_FRONTEND_IMAGE=ghcr.io/yashthebabydragon/ggprint-web-frontend
GGPRINT_IMAGE_TAG=latest
GGPRINT_UPDATER_DIR=./data/updater
GITHUB_REPO=yashTheBabyDragon/GGPrint-Web
GITHUB_TOKEN=
