[Unit]
Description=GGPrint On-Demand GitHub Release Updater (Docker Compose)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ggprint
EnvironmentFile=-/opt/ggprint/.env
ExecStart=/opt/ggprint/deploy/update-from-release.sh --from-trigger
Nice=10
IOSchedulingClass=idle
