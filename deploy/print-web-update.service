[Unit]
Description=Print-Web On-Demand GitHub Release Updater (Docker Compose)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/print-web
ExecStart=/bin/bash /opt/print-web/deploy/update-from-release.sh --from-trigger
Nice=10
IOSchedulingClass=idle
