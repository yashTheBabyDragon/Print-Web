# =============================================================================
# GGPrint — Production Environment Configuration Example (Docker Compose + GHCR)
# =============================================================================
# Copy to .env next to docker-compose.yml (chmod 600 .env).
# Or run deploy/install-debian.sh to generate it automatically with random secrets.

# --- PostgreSQL (Docker Compose) ---------------------------------------------
POSTGRES_DB=ggprint
POSTGRES_USER=ggprint
# Generate a strong password: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-strong-db-password

# --- Core Security & Auth ----------------------------------------------------
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=replace-with-64-char-random-hex-secret
JWT_EXPIRE_MINUTES=10080

# Keep false in production. Only set true once on a fresh DB if you want demo
# seed accounts (Admin DA 0000001 / admin123), then change password and set false.
DEV_SEED=false
INSTITUTION=Cégep Gérald-Godin

# --- Background Polling & CORS -----------------------------------------------
POLL_INTERVAL_SECONDS=15
# JSON array of allowed origins (include your HTTPS domain in production)
CORS_ORIGINS=["https://ggprint.example.edu","http://localhost"]

# --- Published Host Ports ----------------------------------------------------
FRONTEND_PORT=80
BACKEND_PORT=8000

# --- Pre-Built GHCR Images & On-Demand Release Updates -----------------------
# Managed automatically by deploy/install-debian.sh and deploy/update-from-release.sh
GGPRINT_IMAGE_TAG=latest
GGPRINT_UPDATER_DIR=/opt/ggprint/updater
APP_VERSION=
GITHUB_REPO=yashTheBabyDragon/GGPrint-Web
# Optional custom image overrides (defaults point to GitHub Container Registry):
# GGPRINT_BACKEND_IMAGE=ghcr.io/yashthebabydragon/ggprint-web-backend
# GGPRINT_FRONTEND_IMAGE=ghcr.io/yashthebabydragon/ggprint-web-frontend
# Optional GitHub token & username (for private GHCR packages or higher API rate limits):
# GITHUB_TOKEN=
# GITHUB_ACTOR=
# Optional: require signed git tags during auto-updates:
# GGPRINT_VERIFY_SIGNATURES=true
